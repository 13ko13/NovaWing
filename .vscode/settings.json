{
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    // 既存ソースは UTF-8(BOM付き) が中心だが、一部 .hlsl が Shift-JIS なので自動判定させる。
    // 新規ファイルは MSVC が文字コードを誤認しないよう BOM 付きで保存する (Visual Studio と同じ)。
    "files.autoGuessEncoding": true,
    "files.encoding": "utf8bom",
    // Visual Studio 2019/2022 の Dark 配色 (C/C++ Themes 拡張 ms-vscode.cpptools-themes が必要)。
    // テーマ側で VS とずれている「文字列」「列挙型・列挙子」だけ VS の既定色に合わせて上書きする。
    "workbench.colorTheme": "Visual Studio Dark - C++",
    "editor.tokenColorCustomizations": {
        "[Visual Studio Dark - C++]": {
            "textMateRules": [
                {
                    "scope": [
                        "string",
                        "meta.preprocessor.string"
                    ],
                    "settings": {
                        "foreground": "#D69D85"
                    }
                },
                {
                    "scope": "variable.other.enummember",
                    "settings": {
                        "foreground": "#B8D7A3"
                    }
                }
            ]
        }
    },
    "editor.semanticTokenColorCustomizations": {
        "[Visual Studio Dark - C++]": {
            "rules": {
                "stringLiteral": "#D69D85",
                "enum": "#B8D7A3",
                "enumMember": "#B8D7A3"
            }
        }
    },
    // Visual Studio は入力中 (; や } を打ったとき) は自前の整形エンジンで NovaWing/.editorconfig の cpp_* 設定を使い、
    // clang-format (.clang-format) は Ctrl+K Ctrl+D などの手動整形のときだけ使う設定になっている。
    // VS Code はどちらか一方しか選べないため、普段の入力中の動きを合わせて Visual C++ の整形エンジン (vcFormat) にする。
    // (そのため VS Code の Ctrl+K Ctrl+D も .editorconfig 基準になり、VS の手動整形とは細部が違うことがある)
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.formatting": "vcFormat",
    // タブ幅4・インデント4・タブ文字は VS の [テキストエディター > C/C++ > タブ] と同じ。
    // formatOnType は VS の「; や } の入力時に自動で整形する」に合わせて有効にしている。
    "[cpp]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnPaste": false,
        "editor.formatOnSave": false,
        "editor.formatOnType": true
    },
    "[c]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnPaste": false,
        "editor.formatOnSave": false,
        "editor.formatOnType": true
    }
}
