{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "dxlib",
            "config": "debug",
            "label": "DxLib: Debug ビルド",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "dxlib",
            "config": "release",
            "label": "DxLib: Release ビルド",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "NovaWing: クラスの追加",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\scripts\\New-GameClass.ps1",
                "-ClassName",
                "${input:newClassName}",
                "-BaseClass",
                "${input:newClassBase}",
                "-Folder",
                "${input:newClassFolder}",
                "-BaseHeader",
                "${input:newClassBaseHeader}"
            ],
            "options": {
                "statusbar": {
                    "label": "$(add) クラスの追加",
                    "detail": ".h/.cpp を作って vcxproj に登録 (Ctrl+Shift+Alt+C)"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Delete C++ Class",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\scripts\\Remove-GameClass.ps1",
                "-Path",
                "${input:targetClassPath}",
                "-CurrentFile",
                "${file}"
            ],
            "options": {
                "statusbar": {
                    "label": "$(trash) クラスの削除",
                    "detail": "開いている .h/.cpp のクラスを削除 (Ctrl+Shift+Alt+D)",
                    "filePattern": "\\.(h|cpp)$"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Rename C++ Class (filename only)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\scripts\\Rename-GameClass.ps1",
                "-Path",
                "${input:targetClassPath}",
                "-NewName",
                "${input:renameClassNewName}",
                "-CurrentFile",
                "${file}"
            ],
            "options": {
                "statusbar": {
                    "label": "$(edit) ファイル名の変更",
                    "detail": "開いている .h/.cpp のファイル名を変更 (Ctrl+Shift+Alt+R)",
                    "filePattern": "\\.(h|cpp)$"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "NovaWing: AIテストプレイ",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\DebugTools\\AutoPlay\\Run-AutoPlay.ps1",
                "-Runs",
                "${input:autoPlayRuns}",
                "-Speed",
                "${input:autoPlaySpeed}",
                "-Mode",
                "${input:autoPlayMode}",
                "-Skill",
                "${input:autoPlaySkill}"
            ],
            "dependsOn": "DxLib: Debug ビルド",
            "options": {
                "statusbar": {
                    "label": "$(robot) AIテストプレイ",
                    "detail": "AIに自動で遊ばせて、被弾・死亡・カウンターをグラフにする"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "NovaWing: AIテストプレイの結果",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process '${workspaceFolder}\\DebugTools\\AutoPlay\\PlaytestReport.html'"
            ],
            "options": {
                "statusbar": {
                    "label": "$(graph) テスト結果",
                    "detail": "AIテストプレイの結果のグラフをブラウザで開く"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "autoPlayRuns",
            "type": "pickString",
            "description": "AIテストプレイ (1/4) 何回遊ばせますか?",
            "options": [
                { "label": "3回 (お試し)", "value": "3" },
                { "label": "10回", "value": "10" },
                { "label": "20回", "value": "20" },
                { "label": "50回", "value": "50" }
            ],
            "default": "10"
        },
        {
            "id": "autoPlaySpeed",
            "type": "pickString",
            "description": "AIテストプレイ (2/4) 速さは?",
            "options": [
                { "label": "最速 (画面はカクカク、一番早く終わる)", "value": "max" },
                { "label": "4倍速", "value": "4" },
                { "label": "2倍速", "value": "2" },
                { "label": "等速 (普通の速さ、音も鳴る)", "value": "1" }
            ],
            "default": "max"
        },
        {
            "id": "autoPlayMode",
            "type": "pickString",
            "description": "AIテストプレイ (3/4) ゲーム画面を出しますか?",
            "options": [
                { "label": "出す (AIが遊ぶ様子を見る。ESCで中断)", "value": "visible" },
                { "label": "出さない (裏で回す。ターミナルでCtrl+Cで中断)", "value": "hidden" }
            ],
            "default": "visible"
        },
        {
            "id": "autoPlaySkill",
            "type": "pickString",
            "description": "AIテストプレイ (4/4) AIの腕前は?",
            "options": [
                { "label": "初心者 (反応が遅く、よく被弾する)", "value": "beginner" },
                { "label": "普通", "value": "normal" },
                { "label": "上級者 (反応が速く、カウンターをよく使う)", "value": "expert" }
            ],
            "default": "normal"
        },
        {
            "id": "newClassName",
            "type": "promptString",
            "description": "クラス名 (例: ShieldEnemy)"
        },
        {
            "id": "newClassBase",
            "type": "promptString",
            "description": "基底クラス名 (なければ空のままEnter)",
            "default": ""
        },
        {
            "id": "newClassFolder",
            "type": "promptString",
            "description": "配置先フォルダ (プロジェクトフォルダからの相対パス。例: Game/GameObjects/Actors/Character/Enemy)",
            "default": "Game/"
        },
        {
            "id": "newClassBaseHeader",
            "type": "promptString",
            "description": "基底クラスのヘッダー (例: Game/UI/UIBase.h)。空なら「基底クラス名.h」を自動検索",
            "default": ""
        },
        {
            "id": "targetClassPath",
            "type": "promptString",
            "description": "対象クラスの .h か .cpp (例: Game/UI/ReticleUI.h)。空のままEnterで今開いているファイル",
            "default": ""
        },
        {
            "id": "renameClassNewName",
            "type": "promptString",
            "description": "新しいファイル名 (拡張子なし。.h/.cpp 両方に使う)"
        }
    ]
}
