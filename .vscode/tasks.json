{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "dxlib",
            "config": "debug",
            "label": "DxLib: Debug ビルド",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "dxlib",
            "config": "release",
            "label": "DxLib: Release ビルド",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "NovaWing: クラスの追加",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\scripts\\New-GameClass.ps1",
                "-ClassName",
                "${input:newClassName}",
                "-BaseClass",
                "${input:newClassBase}",
                "-Folder",
                "${input:newClassFolder}",
                "-BaseHeader",
                "${input:newClassBaseHeader}"
            ],
            "options": {
                "statusbar": {
                    "label": "$(add) クラスの追加",
                    "detail": ".h/.cpp を作って vcxproj に登録 (Ctrl+Shift+Alt+C)"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Delete C++ Class",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\scripts\\Remove-GameClass.ps1",
                "-Path",
                "${input:targetClassPath}",
                "-CurrentFile",
                "${file}"
            ],
            "options": {
                "statusbar": {
                    "label": "$(trash) クラスの削除",
                    "detail": "開いている .h/.cpp のクラスを削除 (Ctrl+Shift+Alt+D)",
                    "filePattern": "\\.(h|cpp)$"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Rename C++ Class (filename only)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\scripts\\Rename-GameClass.ps1",
                "-Path",
                "${input:targetClassPath}",
                "-NewName",
                "${input:renameClassNewName}",
                "-CurrentFile",
                "${file}"
            ],
            "options": {
                "statusbar": {
                    "label": "$(edit) ファイル名の変更",
                    "detail": "開いている .h/.cpp のファイル名を変更 (Ctrl+Shift+Alt+R)",
                    "filePattern": "\\.(h|cpp)$"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        }
    ],
    "inputs": [
        {
            "id": "newClassName",
            "type": "promptString",
            "description": "クラス名 (例: ShieldEnemy)"
        },
        {
            "id": "newClassBase",
            "type": "promptString",
            "description": "基底クラス名 (なければ空のままEnter)",
            "default": ""
        },
        {
            "id": "newClassFolder",
            "type": "promptString",
            "description": "配置先フォルダ (プロジェクトフォルダからの相対パス。例: Game/GameObjects/Actors/Character/Enemy)",
            "default": "Game/"
        },
        {
            "id": "newClassBaseHeader",
            "type": "promptString",
            "description": "基底クラスのヘッダー (例: Game/UI/UIBase.h)。空なら「基底クラス名.h」を自動検索",
            "default": ""
        },
        {
            "id": "targetClassPath",
            "type": "promptString",
            "description": "対象クラスの .h か .cpp (例: Game/UI/ReticleUI.h)。空のままEnterで今開いているファイル",
            "default": ""
        },
        {
            "id": "renameClassNewName",
            "type": "promptString",
            "description": "新しいファイル名 (拡張子なし。.h/.cpp 両方に使う)"
        }
    ]
}
